<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itmal.tutorapplication.mapper.TutorApplicationMapper">

    <resultMap id="TutorApplicationResultMap" type="com.itmal.tutorapplication.domain.TutorApplication">
        <id property="tutorApplicationId" column="tutor_application_id"/>
        <result property="userId" column="user_id"/>
        <result property="status" column="status"/>
        <result property="appliedAt" column="applied_at"/>
        <result property="processedAt" column="processed_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="tutorApplicationId">
        INSERT INTO tutor_application (user_id, status)
        VALUES (#{userId}, #{status})
    </insert>

    <select id="findById" resultMap="TutorApplicationResultMap">
        SELECT *
        FROM tutor_application
        WHERE tutor_application_id = #{id}
    </select>

    <select id="findPendingByUserId" resultMap="TutorApplicationResultMap">
        SELECT *
        FROM tutor_application
        WHERE user_id = #{userId}
          AND status = 'PENDING'
    </select>

    <select id="findAllPending" resultMap="TutorApplicationResultMap">
        SELECT *
        FROM tutor_application
        WHERE status = 'PENDING'
        ORDER BY applied_at ASC
    </select>

    <select id="findAllPendingWithUser" resultType="com.itmal.tutorapplication.dto.TutorApplicationResponse">
        SELECT ta.tutor_application_id, ta.user_id, u.nickname, u.email, ta.applied_at
        FROM tutor_application ta
        JOIN users u ON ta.user_id = u.user_id
        WHERE ta.status = 'PENDING'
        ORDER BY ta.applied_at ASC
    </select>

    <update id="updateStatus">
        UPDATE tutor_application
        SET status       = #{status},
            processed_at = NOW()
        WHERE tutor_application_id = #{tutorApplicationId}
    </update>

    <update id="rejectPendingByUserId">
        UPDATE tutor_application
        SET status       = 'REJECTED',
            processed_at = NOW()
        WHERE user_id = #{userId}
          AND status = 'PENDING'
    </update>

</mapper>
