<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itmal.answer.mapper.AnswerMapper">

    <!--
        resultMap: DB 컬럼명(snake_case) ↔ Java 필드명(camelCase) 매핑
        예) answer_id → answerId, question_id → questionId
    -->
    <resultMap id="AnswerResultMap" type="com.itmal.answer.domain.Answer">
        <id property="answerId" column="answer_id"/>
        <result property="questionId" column="question_id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="likeCount" column="like_count"/>
        <result property="isAccepted" column="is_accepted"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <resultMap id="AnswerResponseResultMap" type="com.itmal.answer.dto.AnswerResponse">
        <id property="answerId" column="answer_id"/>
        <result property="questionId" column="question_id"/>
        <result property="userId" column="user_id"/>
        <result property="nickname" column="nickname"/>
        <result property="content" column="content"/>
        <result property="likeCount" column="like_count"/>
        <result property="isAccepted" column="is_accepted"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 답변 목록 조회 (닉네임 포함, 질문 상세 페이지용) -->
    <select id="findResponsesByQuestionId" resultMap="AnswerResponseResultMap">
        SELECT a.answer_id, a.question_id, a.user_id,
               COALESCE(u.nickname, '탈퇴한 회원') AS nickname,
               a.content, a.is_accepted, a.created_at,
               (SELECT COUNT(*) FROM answer_like WHERE answer_id = a.answer_id) AS like_count
        FROM answer a
        LEFT JOIN users u ON a.user_id = u.user_id AND u.deleted_at IS NULL
        WHERE a.question_id = #{questionId}
          AND a.deleted_at IS NULL
        ORDER BY a.is_accepted DESC, a.created_at DESC
    </select>

    <!-- 답변 등록 -->
    <!-- useGeneratedKeys: DB가 자동 생성한 PK를 answerId에 넣어줌 -->
    <insert id="insertAnswer" useGeneratedKeys="true" keyProperty="answerId">
        INSERT INTO answer (question_id, user_id, content)
        VALUES (#{questionId}, #{userId}, #{content})
    </insert>

    <!-- 답변 목록 조회 -->
    <!-- deleted_at IS NULL: 소프트 삭제된 답변은 제외 -->
    <select id="findByQuestionId" resultMap="AnswerResultMap">
        SELECT *
        FROM answer
        WHERE question_id = #{questionId}
          AND deleted_at IS NULL
        ORDER BY created_at DESC
    </select>

    <!-- 답변 단건 조회 -->
    <select id="findById" resultMap="AnswerResultMap">
        SELECT *
        FROM answer
        WHERE answer_id = #{answerId}
          AND deleted_at IS NULL
    </select>

    <!-- 답변 수정 -->
    <!-- updated_at은 NOW()로 현재 시각 자동 기록 -->
    <update id="updateAnswer">
        UPDATE answer
        SET content    = #{content},
            updated_at = NOW()
        WHERE answer_id = #{answerId}
    </update>

    <!-- 답변 삭제 (소프트 삭제) -->
    <!-- 실제로 행을 지우지 않고 deleted_at에 시각을 기록해서 삭제 처리 -->
    <update id="deleteAnswer">
        UPDATE answer
        SET deleted_at = NOW()
        WHERE answer_id = #{answerId}
    </update>

    <!-- 좋아요 추가 -->
    <insert id="insertAnswerLike">
        INSERT INTO answer_like (answer_id, user_id)
        VALUES (#{answerId}, #{userId})
    </insert>

    <!-- 좋아요 취소 -->
    <delete id="deleteAnswerLike">
        DELETE FROM answer_like
        WHERE answer_id = #{answerId}
          AND user_id = #{userId}
    </delete>

    <!-- 좋아요 여부 확인 -->
    <select id="findAnswerLike" resultType="com.itmal.answer.domain.AnswerLike">
        SELECT *
        FROM answer_like
        WHERE answer_id = #{answerId}
          AND user_id = #{userId}
    </select>

    <!-- 채택 -->
    <update id="acceptAnswer">
        UPDATE answer
        SET is_accepted = TRUE
        WHERE answer_id = #{answerId}
    </update>

    <!-- 마이페이지용 내 답변 목록 조회 -->
    <select id="findByUserId" resultMap="AnswerResultMap">
        SELECT *
        FROM answer
        WHERE user_id = #{userId}
          AND deleted_at IS NULL
        ORDER BY created_at DESC
    </select>

</mapper>
